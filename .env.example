# Gemini
GEMINI_API_KEY=

# ElevenLabs — cloned voice for the AI Employee voice mode.
# When unset (either var missing), the voice endpoint returns 503 and the
# client silently falls back to the browser's built-in speechSynthesis.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional. Defaults to eleven_turbo_v2_5 (fastest, supports Arabic + ~32 langs).
# Alternatives: eleven_multilingual_v2 (higher fidelity, slower), eleven_v3 (newest, slowest).
ELEVENLABS_MODEL_ID=

# Resend
RESEND_API_KEY=
LEAD_EMAIL_TO=contact@ensignksa.com
LEAD_EMAIL_FROM=Ensign Intelligence <onboarding@resend.dev>

# Vercel KV (auto-populated when KV is provisioned on Vercel)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Local dev: set to 1 to use an in-memory KV stub (no Vercel KV needed)
LOCAL_KV_STUB=1

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
